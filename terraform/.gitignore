# personlig
*.sh

# Terraform variable files (may contain secrets)
*.tfvars
*.tfvars.json

# Allow example files
!*.example.tfvars

# Terraform state
*.tfstate
*.tfstate.*
.terraform.tfstate.lock.info

# Terraform working directory
.terraform/

# Terraform crash logs
crash.log
crash.*.log

# Override files (local customizations)
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Terraform CLI config (may contain credentials)
.terraformrc
terraform.rc

# Environment files
.env
.env.*

